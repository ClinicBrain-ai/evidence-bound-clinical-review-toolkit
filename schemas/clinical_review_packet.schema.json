{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/clinical_review_packet.schema.json",
  "title": "Clinical Review Packet",
  "description": "Schema for a healthcare-adjacent AI output review packet. This schema validates packet structure only and does not validate clinical correctness.",
  "type": "object",
  "required": [
    "packet_id",
    "case_type",
    "ai_output_type",
    "original_ai_output",
    "source_evidence",
    "missing_information",
    "risk_assessment",
    "review_requirement",
    "review_status",
    "audit_events"
  ],
  "properties": {
    "packet_id": {
      "type": "string",
      "minLength": 1
    },
    "case_type": {
      "type": "string",
      "minLength": 1
    },
    "ai_output_type": {
      "type": "string",
      "minLength": 1
    },
    "original_ai_output": {
      "type": "object",
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "source_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "evidence_id",
          "source",
          "excerpt",
          "supports"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "excerpt": {
            "type": "string",
            "minLength": 1
          },
          "supports": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    },
    "missing_information": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "field",
          "status",
          "reason"
        ],
        "properties": {
          "field": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "missing",
              "present",
              "unknown",
              "not_applicable"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    },
    "risk_assessment": {
      "type": "object",
      "required": [
        "risk_level",
        "reason"
      ],
      "properties": {
        "risk_level": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "review_requirement": {
      "type": "object",
      "required": [
        "human_review_required",
        "review_reason"
      ],
      "properties": {
        "human_review_required": {
          "type": "boolean"
        },
        "review_reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "review_status": {
      "type": "object",
      "required": [
        "status",
        "reviewer_role",
        "decision",
        "reviewer_comment"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "reviewed",
            "not_required"
          ]
        },
        "reviewer_role": {
          "type": "string",
          "minLength": 1
        },
        "decision": {
          "type": "string",
          "enum": [
            "approved",
            "requires_revision",
            "rejected",
            "escalated",
            "pending"
          ]
        },
        "reviewer_comment": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "audit_events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "event_type",
          "timestamp",
          "actor",
          "details"
        ],
        "properties": {
          "event_type": {
            "type": "string",
            "minLength": 1
          },
          "timestamp": {
            "type": "string",
            "minLength": 1
          },
          "actor": {
            "type": "string",
            "minLength": 1
          },
          "details": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
